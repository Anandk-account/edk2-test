[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = LogoDxe
  MODULE_UNI_FILE                = LogoDxe.uni
  FILE_GUID                      = F74D20EE-37E7-48FC-97F7-9B1047749C69
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

  ENTRY_POINT                    = InitializeLogo
#
#  This flag specifies whether HII resource section is generated into PE image.
#
  UEFI_HII_RESOURCE_SECTION      = TRUE

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64
#

[Sources]
  Logo.bmp
  Logo.c
  Logo.idf

[Packages]
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  
  UefiCpuPkg/UefiCpuPkg.dec      # Added
  NetworkPkg/NetworkPkg.dec              # Added for HTTP Boot 
  

[LibraryClasses]
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  DebugLib
  
  
  UefiRuntimeServicesTableLib
  UefiLib
  PrintLib
  
  
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  PcdLib
  
  CpuLib 
  
  DevicePathLib
  
 # Network Libraries (for HTTP Boot)
  NetLib                                 # ADD THIS - Network utility functions
  HttpLib                                # ADD THIS - HTTP parsing functions
  DpcLib                                 # ADD THIS - Deferred Procedure Call
  IpIoLib                                # ADD THIS - IP I/O operations
  
  [Protocols]
  gEfiHiiDatabaseProtocolGuid        ## CONSUMES
  gEfiHiiImageExProtocolGuid         ## CONSUMES
  gEfiHiiPackageListProtocolGuid     ## PRODUCES CONSUMES
  gEdkiiPlatformLogoProtocolGuid     ## PRODUCES
  
  
  gEfiSimpleTextInProtocolGuid        ## CONSUMES
  gEfiSimpleTextOutProtocolGuid       ## CONSUMES
  
  gEfiSimplePointerProtocolGuid       ## CONSUMES 
  gEfiGraphicsOutputProtocolGuid      ## SOMETIMES_CONSUMES
  
  
  gEfiLoadedImageProtocolGuid        ## CONSUMES
  gEfiUsbIoProtocolGuid              ## CONSUMES
  
  gEfiMpServiceProtocolGuid        # Add this for multi-processor services
  
  gEfiSmbiosProtocolGuid                     ## CONSUMES
  gEfiCpuIo2ProtocolGuid                     ## CONSUMES
  gEfiCpuArchProtocolGuid                    ## CONSUMES
  gEfiPciRootBridgeIoProtocolGuid               ## CONSUMES
  
  gEfiBlockIoProtocolGuid                   # ADD THIS (for USB boot)
  gEfiDiskIoProtocolGuid                    # ADD THIS (for USB boot)
  
  gEfiSimpleFileSystemProtocolGuid     ## CONSUMED - Shell launch ke liye
  gEfiLoadedImageProtocolGuid          ## CONSUMED - Shell launch ke liye
  
  
 # Network Protocols - ADDED FOR NETWORK BOOT
  gEfiSimpleNetworkProtocolGuid                 ## SOMETIMES_CONSUMES
  gEfiNetworkInterfaceIdentifierProtocolGuid    ## SOMETIMES_CONSUMES
  gEfiManagedNetworkProtocolGuid                ## SOMETIMES_CONSUMES
  gEfiPxeBaseCodeProtocolGuid                   ## SOMETIMES_CONSUMES
  
  
  
  
 # TCP/IP Stack Protocols
  gEfiIp4Config2ProtocolGuid                    ## SOMETIMES_CONSUMES
  gEfiIp4ProtocolGuid                           ## SOMETIMES_CONSUMES - ADD THIS
  gEfiIp4ServiceBindingProtocolGuid             ## SOMETIMES_CONSUMES - ADD THIS
  gEfiIp6ProtocolGuid                           ## SOMETIMES_CONSUMES - ADD THIS (IPv6 support)
  gEfiIp6ServiceBindingProtocolGuid             ## SOMETIMES_CONSUMES - ADD THIS
  gEfiIp6ConfigProtocolGuid                     ## SOMETIMES_CONSUMES - ADD THIS
  
  
 # DHCP Protocols  
  gEfiDhcp4ProtocolGuid                         ## SOMETIMES_CONSUMES
  gEfiDhcp4ServiceBindingProtocolGuid           ## SOMETIMES_CONSUMES - ADD THIS
  gEfiDhcp6ProtocolGuid                         ## SOMETIMES_CONSUMES - ADD THIS (IPv6 DHCP)
  gEfiDhcp6ServiceBindingProtocolGuid           ## SOMETIMES_CONSUMES - ADD THIS
  
  
 # HTTP Protocols - 
  gEfiHttpProtocolGuid                          ## SOMETIMES_CONSUMES - ADD THIS
  gEfiHttpServiceBindingProtocolGuid            ## SOMETIMES_CONSUMES - ADD THIS
  gEfiHttpUtilitiesProtocolGuid                 ## SOMETIMES_CONSUMES - ADD THIS
  
  gEfiLoadFileProtocolGuid                      ## CONSUMES
  gEfiLoadFile2ProtocolGuid                    ## CONSUMES
  gEfiDevicePathProtocolGuid                    ## CONSUMES
  
  
 # HTTP Boot Protocol - MAIN PROTOCOL
 # gEfiHttpBootProtocolGuid                      ## SOMETIMES_CONSUMES - ADD THIS (MAIN!)
  gEfiHttpBootCallbackProtocolGuid              ## SOMETIMES_CONSUMES - ADD THIS
  
  
 # DNS Protocols (for hostname resolution)
  gEfiDns4ProtocolGuid                          ## SOMETIMES_CONSUMES
  gEfiDns4ServiceBindingProtocolGuid            ## SOMETIMES_CONSUMES
  gEfiDns6ProtocolGuid                          ## SOMETIMES_CONSUMES
  gEfiDns6ServiceBindingProtocolGuid            ## SOMETIMES_CONSUMES 
  
  
[Guids]
  gEfiGlobalVariableGuid                     ## CONSUMES
  gEfiFileInfoGuid                           ## CONSUMES
  
  
  gEfiAcpiTableGuid                          ## CONSUMES
  gEfiAcpi10TableGuid                        ## CONSUMES
  
  gEfiVirtualDiskGuid                        ## CONSUMES - ADD THIS (HTTP boot image)

[Depex]
  gEfiHiiDatabaseProtocolGuid AND
  gEfiHiiImageExProtocolGuid AND  
  
  
  gEfiSimpleTextOutProtocolGuid AND
  gEfiSimpleTextInProtocolGuid  
  
  
#  gEfiSimpleNetworkProtocolGuid
  
  
  
[UserExtensions.TianoCore."ExtraFiles"]
  LogoDxeExtra.uni
